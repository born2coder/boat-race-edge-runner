{
  "name": "boat-edge-startup-watchdog",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": { "WATCHDOG_ENABLED": "1" },
  "triggers": { "crons": ["*/15 0-14,22-23 * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
